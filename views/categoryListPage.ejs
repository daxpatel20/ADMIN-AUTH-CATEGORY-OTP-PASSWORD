<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title>View Category | DeskApp</title>
    <link rel="shortcut icon" href="/adminkit/img/icons/icon-48x48.png" />
    <link href="/adminkit/css/app.css" rel="stylesheet">
    <link href="/css/custom.css" rel="stylesheet" />
</head>
<body>
    <div class="wrapper">
        <nav id="sidebar" class="sidebar js-sidebar">
            <%- include('partials/adminSidebar', { activePage: 'viewCategory', layout: 'adminkit' }) %>
        </nav>

        <div class="main">
            <%- include('partials/adminHeader', { pageTitle: 'View Category', pageSubtitle: 'Manage category names in table format.', actionButton: { href: '/category/add', label: 'Add Category' } }) %>

            <main class="content">
                <div class="container-fluid p-0">
                    <div class="d-flex justify-content-between align-items-center mb-4 page-heading-row">
                        <div>
                            <h1 class="adminkit-title mb-1"><strong>View Category</strong></h1>
                            <p class="text-muted mb-0">Edit or delete category names from one clean table.</p>
                        </div>
                        <a href="/category/add" class="btn btn-light">Add Category</a>
                    </div>

                    <% if (success) { %>
                        <div class="success-box alert-dismissible-custom"><span><%= success %></span><button type="button" class="msg-close-btn" aria-label="Close message">×</button></div>
                    <% } %>
                    <% if (error) { %>
                        <div class="error-box alert-dismissible-custom"><span><%= error %></span><button type="button" class="msg-close-btn" aria-label="Close message">×</button></div>
                    <% } %>

                    <div class="form-card category-table-card mt-4">
                        <% if (!categories || categories.length === 0) { %>
                            <div class="empty-box">No category found. Please add your first category.</div>
                        <% } else { %>
                            <div class="table-responsive">
                                <table class="table category-table align-middle mb-0">
                                    <thead>
                                        <tr>
                                            <th>No.</th>
                                            <th>Category Name</th>
                                            <th>Created Date</th>
                                            <th class="text-end">Action</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% categories.forEach((category, index) => { %>
                                            <tr>
                                                <td><span class="table-number"><%= index + 1 %></span></td>
                                                <td><strong><%= category.categoryName %></strong></td>
                                                <td><%= category.createdAt ? category.createdAt.toLocaleDateString('en-IN') : '-' %></td>
                                                <td class="text-end">
                                                    <a href="/category/edit/<%= category._id %>" class="btn btn-sm btn-outline-light category-icon-btn" title="Edit">
                                                        <i data-feather="edit-2"></i>
                                                    </a>
                                                    <form action="/category/delete/<%= category._id %>" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this category?')">
                                                        <button type="submit" class="btn btn-sm btn-danger category-icon-btn" title="Delete">
                                                            <i data-feather="trash-2"></i>
                                                        </button>
                                                    </form>
                                                </td>
                                            </tr>
                                        <% }) %>
                                    </tbody>
                                </table>
                            </div>
                        <% } %>
                    </div>
                </div>
            </main>
        </div>
    </div>
    <script src="/adminkit/js/app.js"></script>
    <script src="/js/message-close.js"></script>
</body>
</html>
