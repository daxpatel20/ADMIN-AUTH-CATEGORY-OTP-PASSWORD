<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Forgot Password | DeskApp</title>
    <link href="/css/bootstrap.min.css" rel="stylesheet" />
    <link href="/css/app-style.css" rel="stylesheet" />
    <link href="/css/custom.css" rel="stylesheet" />
    <style>
        .otp-modal-backdrop{position:fixed;inset:0;background:rgba(0,0,0,.7);display:flex;align-items:center;justify-content:center;padding:20px;z-index:9999}.otp-modal-card{width:100%;max-width:430px;background:#fff;color:#222;border-radius:18px;padding:28px;box-shadow:0 24px 70px rgba(0,0,0,.35)}.otp-input{text-align:center;font-size:28px;letter-spacing:10px;font-weight:700}.resend-row{display:flex;justify-content:center;align-items:center;gap:8px;margin-top:15px}.resend-btn{border:0;background:none;color:#6f42c1;font-weight:700;cursor:pointer}.resend-btn:disabled{color:#777;cursor:not-allowed}.reset-title{font-weight:700}.password-field-wrap{position:relative}.password-eye-btn{position:absolute;right:10px;top:50%;transform:translateY(-50%);border:0;background:transparent;color:#222;font-size:13px}.form-control{padding-right:80px}
    </style>
</head>
<body class="bg-theme bg-theme1">
<div id="wrapper">
    <div class="auth-card-clean">
        <div class="text-center mb-4">
            <img src="/img/logo-icon.png" width="60" alt="logo" />
            <h4 class="mt-3 mb-0"><%= step === 'reset' ? 'Reset Password' : 'Forgot Password' %></h4>
            <p class="mb-0"><%= step === 'reset' ? 'Create your new secure password' : 'Enter your registered email' %></p>
        </div>

        <% if (success) { %><div class="success-box alert-dismissible-custom"><span><%= success %></span><button type="button" class="msg-close-btn">×</button></div><% } %>
        <% if (error) { %><div class="error-box alert-dismissible-custom"><span><%= error %></span><button type="button" class="msg-close-btn">×</button></div><% } %>

        <% if (step === 'reset') { %>
            <form action="/forgot-password/reset" method="post">
                <input type="hidden" name="email" value="<%= email %>" />
                <input type="hidden" name="token" value="<%= token %>" />
                <div class="form-group">
                    <label>New Password</label>
                    <div class="password-field-wrap"><input id="newPassword" type="password" name="newPassword" class="form-control input-shadow" required /><button type="button" class="password-eye-btn" data-target="newPassword">👁 Show</button></div>
                </div>
                <div class="form-group">
                    <label>Confirm Password</label>
                    <div class="password-field-wrap"><input id="confirmPassword" type="password" name="confirmPassword" class="form-control input-shadow" required /><button type="button" class="password-eye-btn" data-target="confirmPassword">👁 Show</button></div>
                </div>
                <small class="d-block mb-3">8–15 characters with uppercase, lowercase, number and special character.</small>
                <button type="submit" class="btn btn-light btn-block">Update Password</button>
            </form>
        <% } else { %>
            <form action="/forgot-password/send-otp" method="post">
                <div class="form-group"><label>Email</label><input type="email" name="email" value="<%= email %>" class="form-control input-shadow" placeholder="Enter registered email" required /></div>
                <button type="submit" class="btn btn-light btn-block">Generate OTP</button>
            </form>
        <% } %>
        <div class="text-center mt-3"><a href="/login">Back to Login</a></div>
    </div>
</div>

<% if (openOtpModal) { %>
<div class="otp-modal-backdrop">
    <div class="otp-modal-card">
        <div class="text-center mb-3"><h4 class="reset-title">Verify OTP</h4><p class="mb-0">Enter the 6-digit OTP printed in the server console.</p><small>OTP expires in 10 minutes.</small></div>
        <form action="/forgot-password/verify-otp" method="post">
            <input type="hidden" name="email" value="<%= email %>" />
            <input type="hidden" name="token" value="<%= token %>" />
            <input class="form-control otp-input" type="text" name="otp" maxlength="6" inputmode="numeric" pattern="[0-9]{6}" autocomplete="one-time-code" required />
            <button type="submit" class="btn btn-dark btn-block mt-3">Verify OTP</button>
        </form>
        <form action="/forgot-password/resend-otp" method="post" class="resend-row">
            <input type="hidden" name="email" value="<%= email %>" />
            <input type="hidden" name="token" value="<%= token %>" />
            <span id="resendText">Resend available in</span>
            <button id="resendButton" type="submit" class="resend-btn" disabled>Resend OTP (<span id="resendTimer"><%= resendSeconds %></span>s)</button>
        </form>
        <div class="text-center mt-3"><a href="/forgot-password">Use another email</a></div>
    </div>
</div>
<% } %>
<script>
    document.querySelectorAll('.password-eye-btn').forEach((button) => {
        button.addEventListener('click', () => {
            const input = document.getElementById(button.dataset.target);
            const show = input.type === 'password';
            input.type = show ? 'text' : 'password';
            button.textContent = show ? '🙈 Hide' : '👁 Show';
        });
    });

    const timerElement = document.getElementById('resendTimer');
    const resendButton = document.getElementById('resendButton');
    const resendText = document.getElementById('resendText');
    if (timerElement && resendButton) {
        let seconds = parseInt(timerElement.textContent, 10) || 0;
        const updateTimer = () => {
            timerElement.textContent = seconds;
            if (seconds <= 0) {
                resendButton.disabled = false;
                resendButton.innerHTML = 'Resend OTP';
                resendText.textContent = '';
                return;
            }
            seconds -= 1;
            setTimeout(updateTimer, 1000);
        };
        updateTimer();
    }
</script>
<script src="/js/message-close.js"></script>
</body>
</html>
