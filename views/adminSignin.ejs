<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Login | DeskApp</title>
    <link href="/css/bootstrap.min.css" rel="stylesheet" />
    <link href="/css/app-style.css" rel="stylesheet" />
    <link href="/css/custom.css" rel="stylesheet" />
</head>
<body class="bg-theme bg-theme1">
    <div id="wrapper">
        <div class="auth-card-clean">
            <div class="text-center mb-4">
                <img src="/img/logo-icon.png" width="60" alt="logo" />
                <h4 class="mt-3 mb-0">Sign In</h4>
                <p class="mb-0">Login to your admin panel</p>
            </div>

            <% if (typeof success !== 'undefined' && success) { %>
                <div class="success-box alert-dismissible-custom"><span><%= success %></span><button type="button" class="msg-close-btn" aria-label="Close message">×</button></div>
            <% } %>

            <% if (error) { %>
                <div class="error-box alert-dismissible-custom"><span><%= error %></span><button type="button" class="msg-close-btn" aria-label="Close message">×</button></div>
            <% } %>

            <form action="/login" method="post" class="js-password-form">
                <div class="form-group">
                    <label>Email</label>
                    <div class="position-relative">
                        <input type="email" name="email" class="form-control input-shadow" placeholder="Enter Email" required />
                    </div>
                </div>

                <div class="form-group">
                    <label>Password</label>
                    <div class="password-field-wrap">
                        <input type="password" name="password" class="form-control input-shadow password-input js-validate-password" placeholder="Enter Password" required />
                        <button type="button" class="password-eye-btn" aria-label="Show password">👁 Show</button>
                    </div>
                    <small class="password-error-text"></small>
                </div>

                <button type="submit" class="btn btn-light btn-block">Sign In</button>
            </form>

            <div class="text-center mt-3">
                <p class="mb-2"><a href="/forgot-password">Forgot Password?</a></p>
                <p class="mb-0">Do not have an account? <a href="/register">Sign Up here</a></p>
            </div>
        </div>
    </div>
    <script>
        const passwordRules = {
            length: (value) => value.length >= 8 && value.length <= 15,
            upper: (value) => /[A-Z]/.test(value),
            lower: (value) => /[a-z]/.test(value),
            number: (value) => /\d/.test(value),
            special: (value) => /[^A-Za-z0-9]/.test(value)
        };
        const passwordConditionMessage = "Password must be 8 to 15 characters with capital letter, small letter, number and special character.";

        document.querySelectorAll(".password-eye-btn").forEach((button) => {
            button.addEventListener("click", () => {
                const input = button.parentElement.querySelector(".password-input");
                if (!input) return;
                const isPassword = input.type === "password";
                input.type = isPassword ? "text" : "password";
                button.textContent = isPassword ? "🙈 Hide" : "👁 Show";
                button.setAttribute("aria-label", isPassword ? "Hide password" : "Show password");
            });
        });

        const updatePasswordRules = (input) => {
            const value = input.value;
            const box = input.closest(".form-group").querySelector(".password-rules-vertical");
            if (!box) return;

            Object.keys(passwordRules).forEach((rule) => {
                const item = box.querySelector(`[data-rule="${rule}"]`);
                if (!item) return;
                item.classList.toggle("valid", passwordRules[rule](value));
            });
        };

        document.querySelectorAll(".js-validate-password").forEach((input) => {
            input.addEventListener("input", () => updatePasswordRules(input));
            updatePasswordRules(input);
        });

        document.querySelectorAll(".js-password-form").forEach((form) => {
            form.addEventListener("submit", (event) => {
                const input = form.querySelector(".js-validate-password");
                const errorText = form.querySelector(".password-error-text");
                if (!input) return;

                const isValid = Object.values(passwordRules).every((rule) => rule(input.value));
                if (!isValid) {
                    event.preventDefault();
                    updatePasswordRules(input);
                    if (errorText) {
                        errorText.textContent = passwordConditionMessage;
                        errorText.style.display = "block";
                    }
                }
            });
        });

    </script>
    <script src="/js/message-close.js"></script>
</body>
</html>
